<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Graphify.CSharp.Core\Graphify.CSharp.Core.csproj" />
    <ProjectReference Include="..\Graphify.CSharp.Roslyn\Graphify.CSharp.Roslyn.csproj" />
    <ProjectReference Include="..\Graphify.CSharp.Web\Graphify.CSharp.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>graphify-csharp</ToolCommandName>
    <PackageId>Graphify.CSharp</PackageId>
    <Version>0.1.0</Version>
    <Description>Roslyn-powered C# knowledge graph builder and query CLI.</Description>
  </PropertyGroup>

  <Target Name="CopyWebUiAssets" AfterTargets="Build">
    <ItemGroup>
      <WebUiFiles Include="..\Graphify.CSharp.Web\wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebUiFiles)"
          DestinationFiles="@(WebUiFiles->'$(OutputPath)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
